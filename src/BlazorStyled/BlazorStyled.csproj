<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PackageId>DataJuggler.BlazorStyled</PackageId>
    <Version>10.0.0</Version>
    <Authors>Chanan Braunstein is the author. Forked, upgraded and republished by DataJuggler.</Authors>
    <Title>DataJuggler.BlazorStyled</Title>
    <Description>A fork of BlazorStyled by Chanan. CSS in Blazor Components</Description>
    <PackageProjectUrl>https://chanan.github.io/BlazorStyled/</PackageProjectUrl>
    <PackageTags>blazor;css;styled-components</PackageTags>
    <RepositoryUrl>https://github.com/chanan/BlazorStyled</RepositoryUrl>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <PackageReleaseNotes>A fork of BlazorStyled by Chanan, upgraded to .NET 8, and components have been upgraded.</PackageReleaseNotes>
    <PackageIcon>BlazorStyledIcon.png</PackageIcon>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\BlazorStyledIcon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

</Project>
